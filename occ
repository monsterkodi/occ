#!/usr/bin/env node
import { resolveDbPath, openDb, openWritable } from "./src/db.js"
import { createStyle } from "./src/style.js"
import { createTerminal } from "./src/terminal.js"
import { ls } from "./src/ls.js"
import { cat } from "./src/cat.js"
import { log } from "./src/log.js"
import { shell } from "./src/shell.js"
import { del } from "./src/del.js"
import { resume } from "./src/resume.js"
import { OclsError } from "./src/db.js"

function usage()
{
    return `
    occ - list, dump and delete opencode v2 sessions

    usage:

      occ ls [sess...]        show session table
      occ cat [sess...]       show session conversation
      occ log [sess...]       show session history including tool calls
      occ shell [sess...]     show shell commands with their output
      occ resume sess         resume a session in opencode
      occ del sess [sess...]  delete sessions, asks for confirmation

    sess: a fragment of a session id or session title

    table: id datetime minutes turns title
    `
}

const COMMANDS = {
    ls: { run: ls },
    cat: { run: cat },
    log: { run: log },
    shell: { run: shell },
    resume: { run: resume },
    del: { run: del, writable: true },
}

async function main(argv)
{
    const [given, ...ids] = argv

    if (given === "-h" || given === "--help" || given === "help")
    {
        process.stdout.write(usage() + "\n")
        return 0
    }

    const command = argv.length === 0 ? "ls" : given

    const entry = COMMANDS[command]
    if (!entry)
    {
        process.stderr.write(`unknown command "${command}"\n\n${usage()}\n`)
        return 1
    }

    const { run: handler, writable = false } = entry
    const path = resolveDbPath()
    const db = writable ? openWritable(path) : openDb(path)

    try
    {
        const width = process.stdout.columns || 80
        const style = createStyle(Boolean(process.stdout.isTTY) && !process.env.NO_COLOR)
        const out = await handler({ db, prefixes: ids, width, style, io: createTerminal() })

        if (typeof out === "string" && out) process.stdout.write(out + "\n")
        return typeof out === "number" ? out : 0
    }
    finally
    {
        db.close()
    }
}

try
{
    process.exitCode = await main(process.argv.slice(2))
}
catch (e)
{
    if (e instanceof OclsError)
    {
        process.stderr.write(`occ: ${e.message}\n`)
        process.exitCode = 1
    }
    else
    {
        throw e
    }
}

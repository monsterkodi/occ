#  terminal.kode has one export and it is the module, so `use ../terminal`
#  binds the function itself rather than an object to reach through.

import test from 'node:test'
import assert from 'node:assert/strict'

use ../terminal

sink = ->

    chunks = []
    write = (text) -> chunks.push text

    chunks: chunks
    write: write

test.describe 'createTerminal' ->

    test 'writes through to the writer it was given' ->

        out = sink()
        terminal(out, false).write 'hello'

        assert.deepEqual out.chunks, ['hello']

    test 'reports interactivity as given' ->

        assert.equal terminal(sink(), true).interactive, true
        assert.equal terminal(sink(), false).interactive, false

    test 'defaults to non-interactive when stdin is not a terminal' ->

        assert.equal terminal(sink()).interactive, false
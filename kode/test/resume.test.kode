###
████████   ████████   ███████  ███   ███  ██     ██  ████████
███   ███  ███       ███       ███   ███  ███   ███  ███     
███████    ███████   ███████   ███   ███  █████████  ███████ 
███   ███  ███            ███  ███   ███  ███ █ ███  ███     
███   ███  ████████  ███████    ███████   ███   ███  ████████
###

import test from 'node:test'
import assert from 'node:assert/strict'

use ./fixtures/build
use ../db
use ../resume

A = 'ses_aaaaaaaaaaaaaaaaaaaaaaaaa1'
B = 'ses_bbbbbbbbbbbbbbbbbbbbbbb2'

GONE = 'ses_9999999999999999999999g'

withDb = (fn) ->

    database = db.openDb build.buildTestDb()

    try
        out = fn database
    catch err
        database.close()
        throw err

    database.close()
    out

addSession = (database, id, directory, title) ->

    stmt = database.prepare "INSERT INTO session_v2 (id, project_id, parent_id, title, slug, directory, time_created, time_updated) VALUES (?, ?, ?, ?, ?, ?, ?, ?)"
    stmt.run id, 'proj1', null, title, 'quiet-fox', directory, 1, 2

#  A run that records the plans it was handed, so a test can look at both what
#  was launched and what was refused before launching.
#
#  Destructuring is not written as `{plans, code} = attempt ['aaaaaa']`: the
#  call is a sequence, and the destructuring would repeat it once per name.

attempt = (prefixes, opt={}) ->

    plans = []
    launch = (plan) ->
        plans.push plan
        opt.code ? 0

    code = ○-> withDb (database) ->
        resume.resume
            db: database
            prefixes: prefixes
            io: interactive: opt.interactive ? true
            launch: launch

    plans: plans
    code: code

###
████████   ████████  ████████    ███████   ███████   ███   ███   ███████ 
███   ███  ███       ███   ███  ███       ███   ███  ████  ███  ███   ███
████████   ███████   ███████    ███████   ███   ███  ███ █ ███  █████████
███        ███       ███   ███       ███  ███   ███  ███  ████  ███   ███
███        ████████  ███   ███  ███████    ███████   ███   ███  ███   ███
###

test.describe 'personaOf' ->

    test 'the directory basename is the persona' ->

        assert.equal resume.personaOf('/home/kodi/a/coco'), 'coco'
        assert.equal resume.personaOf('/home/kodi/a/bert'), 'bert'

    test 'a dot directory can name a persona of its own' ->

        assert.equal resume.personaOf('/home/kodi/.config'), 'sepp'

    test 'the persona is lowercased' ->

        assert.equal resume.personaOf('/home/kodi/A/Coco'), 'coco'

    test 'a trailing slash does not matter' ->

        assert.equal resume.personaOf('/home/kodi/a/coco/'), 'coco'

###
 ███████   ███   ███   ███████   ████████   ███████     ███████
███        ███   ███  ███   ███  ███   ███  ███   ███  ███     
███  ████  ███   ███  █████████  ███████    ███   ███  ███████ 
███   ███  ███   ███  ███   ███  ███   ███  ███   ███       ███
 ███████    ███████   ███   ███  ███   ███  ███████    ███████ 
###

test.describe 'resume guards' ->

    test 'no session at all is refused' ○->

        run = attempt []
        await assert.rejects(run.code(), (e) ->
            e instanceof db.OclsError and (/exactly\x20one\x20session\x20id/i).test e.message)

    test 'two sessions are refused' ○->

        run = attempt ['aaaaaa', 'cccccc']
        await assert.rejects(run.code(), (e) ->
            e instanceof db.OclsError and (/got\x202/).test e.message)

    test 'a fragment matching several sessions is refused' ○->

        run = attempt ['o']
        await assert.rejects(run.code(), (e) ->
            e instanceof db.OclsError and (/matches\x202\x20sessions/).test e.message)

    test 'the refusal names the fragment and the count' ○->

        run = attempt ['o']
        await assert.rejects(run.code(), /"o".*2/)

    test 'an unknown session is refused' ○->

        run = attempt ['zzzzzz']
        await assert.rejects(run.code(), /no\x20session\x20matches/)

    test 'a non-interactive terminal is refused' ○->

        run = attempt ['aaaaaa'], {interactive: false}

        await assert.rejects(run.code(), (e) ->
            e instanceof db.OclsError and (/terminal/i).test e.message)

    test 'a session whose directory is gone is refused' ○->

        plans = []
        database = db.openWritable build.buildTestDb()

        addSession database, GONE, '/nonexistent/persona', 'Gone - nothing'

        refused = -> resume.resume
            db: database
            prefixes: [GONE]
            io: {interactive: true}
            launch: (plan) -> plans.push plan

        try
            await assert.rejects(refused(), (e) ->
                e instanceof db.OclsError and e.message.includes '/nonexistent/persona')
        catch err
            throw err
        finally
            database.close()

        assert.deepEqual plans, []

    test 'nothing is launched when a guard fires' ○->

        for prefixes in [[] ['aaaaaa' 'cccccc'] ['o'] ['zzzzzz']]
            run = attempt prefixes
            await assert.rejects(run.code())
            joined = prefixes.join ' '
            assert.deepEqual run.plans, [], "#{joined} launched something"

###
████████   ███       ███████   ███   ███
███   ███  ███      ███   ███  ████  ███
████████   ███      █████████  ███ █ ███
███        ███      ███   ███  ███  ████
███        ███████  ███   ███  ███   ███
###

test.describe 'resume plan' ->

    test 'runs opencode on the session' ○->

        run = attempt ['aaaaaa']
        plans = run.plans
        code = run.code

        got = ○code()

        assert.equal got, 0
        assert.equal plans.length, 1
        assert.equal plans[0].command, 'opencode'

    test 'passes the full session id, never the prefix' ○->

        run = attempt ['aaaaaa']
        plans = run.plans
        code = run.code
        await code()

        assert.deepEqual plans[0].args, ['--session', A]

    test 'runs in the directory the session belongs to' ○->

        run = attempt ['aaaaaa']
        plans = run.plans
        code = run.code
        await code()

        assert.equal plans[0].cwd, '/home/kodi/a/coco'

    test 'sets the persona the session runs as' ○->

        run = attempt ['aaaaaa']
        plans = run.plans
        code = run.code
        await code()

        assert.equal plans[0].env.OPENCODE_PERSONA, 'coco'

    test 'a title fragment resolves the same way' ○->

        run = attempt ['ocls']
        plans = run.plans
        code = run.code
        await code()

        assert.deepEqual plans[0].args, ['--session', A]
        assert.equal plans[0].cwd, '/home/kodi/a/coco'

    test 'a session in .config resumes as sepp' ○->

        run = attempt ['bbbbbbb']
        plans = run.plans
        code = run.code
        await code()

        assert.deepEqual plans[0].args, ['--session', B]
        assert.equal plans[0].cwd, '/home/kodi/.config'
        assert.equal plans[0].env.OPENCODE_PERSONA, 'sepp'

    test 'the rest of the environment is inherited' ○->

        run = attempt ['aaaaaa']
        plans = run.plans
        code = run.code
        await code()

        assert.equal plans[0].env.PATH, process.env.PATH

    test 'returns the exit code opencode exited with' ○->

        run = attempt ['aaaaaa'], {code: 42}
        got = ○run.code()
        assert.equal got, 42

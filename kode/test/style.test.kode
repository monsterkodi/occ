###
████████   ████████  ███████  ███    ███ ███████ ████████  ███████
███       ███       ███   ███ ███  ███  ███    ███       ███
██████    ███████   ███████  ███████   █████   ███████   ███████
███       ███       ███   ███ ███   ███  ███    ███          ███
███       ████████  ███████  ███    ███ ███████ ████████  ███████
###

#  the same roles whether or not color is on, every role a function of text, and
#  a style that composes rather than replaces.

import test from 'node:test'
import assert from 'node:assert/strict'

use ../style

strip = (text) -> text.replace /\x1b\[[0-9;]*m/g, ''

groups = ['row' 'turn' 'tool' 'del']

HEX = new Set ['fg', 'bg']

#  Every leaf of the style tree, as a dotted path. A role that is a function is
#  a leaf; a group is walked into.

walk = (style, prefix='', found=[]) ->

    for [key, value] in Object.entries style
        if key in ['enabled' 'palette'] then continue
        if HEX.has key then continue
        path = if prefix then "#{prefix}.#{key}" else key
        if value is func then found.push path
        else walk(value, path, found)

    found

roleOf = (style, path) ->

    fn = style
    for key in path.split '.'
        fn = fn[key]

    fn

test.describe 'createStyle' ->

    test 'exposes the same roles whether or not color is on' ->

        assert.deepEqual walk(style.createStyle(true)), walk(style.createStyle(false))

    test 'every role is a function of text' ->

        for role in walk style.createStyle(true)
            fn = roleOf style.createStyle(true), role
            assert.equal typeof(fn), 'function', "#{role} is not a function"
            assert.equal typeof(fn('x')), 'string'

    test 'reports whether color is enabled' ->

        assert.equal style.createStyle(true).enabled, true
        assert.equal style.createStyle(false).enabled, false

    test 'each expected role exists' ->

        s = style.createStyle true
        for group in groups
            assert.ok s[group], "missing group #{group}"
        assert.deepEqual Object.keys(s.row), ['id' 'last' 'duration' 'turns' 'name']
        assert.deepEqual Object.keys(s.turn), ['user' 'agent' 'mode' 'continue']
        assert.deepEqual Object.keys(s.tool), ['call' 'result' 'exit' 'note']
        assert.deepEqual Object.keys(s.del), ['warning' 'question']

    test 'disabled style returns the text unchanged' ->

        s = style.createStyle false
        for role in walk s
            assert.equal roleOf(s, role)('plain text'), 'plain text', role

    test 'enabled style returns the same visible text' ->

        s = style.createStyle true
        for role in walk s
            assert.equal strip(roleOf(s, role)('plain text')), 'plain text', role

    test 'a dim role wraps text without changing it' ->

        out = style.createStyle(true).turn.continue '…'
        assert.notEqual out, '…'
        assert.equal strip(out), '…'

    test 'nested styles compose rather than replace' ->

        s = style.createStyle true
        inner = s.turn.mode 'build'
        outer = s.tool.result inner

        assert.notEqual inner, outer
        assert.ok strip(outer).includes 'build'

    test 'styling is applied consistently across runs' ->

        a = style.createStyle true
        b = style.createStyle true

        assert.equal a.turn.user('> user'), b.turn.user('> user')
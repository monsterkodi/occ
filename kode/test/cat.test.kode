 ███████  ███   ███     ███           ████████  ███   ███  ███   ███   ███████   ███   ███  ███████ 
###

test.describe 'cat errors' ->

    test 'unknown id surfaces the error' ->

        assert.throws(-> run(['zzzzzz']), /no\x20session/i)

    test 'output ends without a trailing blank line' ->

        out = run ['aaaaaa']
        assert.ok not out.endsWith('\n')

###
    ███████    ████████  ███    
    ███   ███  ███       ███    
    ███   ███  ███████   ███    
    ███   ███  ███       ███    
    ███████    ████████  ███████
###

import test from 'node:test'
import assert from 'node:assert/strict'

use ./fixtures/build
use ../db
use ../del
use ../style

plain = style.createStyle false

A = 'ses_aaaaaaaaaaaaaaaaaaaaaaaaa1'
C = 'ses_ccccccccccccccccccccccc3'

#  A terminal that answers from a list and remembers what was written.

io = (answer='y', interactive=true) ->

    out = []
    answers = answer.split ''

    write = (text) -> out.push text
    readAnswer = -> if answers.length then answers.shift() else undefined

    output = -> out.join ''

    interactive: interactive
    write: write
    readAnswer: readAnswer
    output: output

#  The close is written out on both paths rather than in a finally: a finally
#  block that ends with an expression returns it, which would swallow the throw
#  this helper exists to let through.

run = (ids, answer='y', width=80) ->

    terminal = io answer
    database = db.openWritable build.buildTestDb()

    try
        res = del {db: database, prefixes: ids, width, style: plain, io: terminal}
        out = deleted: res.deleted, text: terminal.output()
    catch err
        database.close()
        throw err

    database.close()
    out

withDb = (fn) ->

    database = db.openWritable build.buildTestDb()

    try
        out = fn database
    catch err
        database.close()
        throw err

    database.close()
    out

deleteA = (database, answer='y') ->
    del {db: database, prefixes: ['aaaaaa'], width: 80, style: plain, io: io(answer)}

rowCount = (database, id) ->
    database.prepare('SELECT count(*) AS c FROM session_v2 WHERE id = ?').get(id).c

#  Named, because an arrow as an argument of assert.throws is more than the
#  parser wants to read: a second arrow on the same statement flattens.

throwsOcls = (pattern) -> (e) -> e instanceof db.OclsError and (pattern.test(e.message))

test.describe 'openWritable' ->

    test 'can actually write' ->

        withDb (database) ->
            database.prepare('DELETE FROM session_v2 WHERE id = ?').run A
            assert.equal rowCount(database, A), 0

    test 'has foreign keys enforced' ->

        withDb (database) ->
            pragma = database.prepare('PRAGMA foreign_keys').get()
            assert.equal pragma.foreign_keys, 1

    test 'rejects a bad schema the same way openDb does' ->

        assert.throws((-> db.openWritable('/nonexistent/opencode.db')), db.OclsError)

test.describe 'del guards' ->

    test 'no ids is an error, and nothing is printed first' ->

        assert.throws((-> run([])), throwsOcls(/id/i))

    test 'an argument shorter than three characters is refused' ->

        for short in ['a' 'ab']
            refused = throwsOcls /at\x20least\x203\x20characters/i
            #  an arrow as the first argument swallows the ones after it, so it
            #  is parenthesised; and a string with escaped quotes is a lexer
            #  hazard, so the message has none.

            assert.throws((-> run([short])), refused, "#{short} should be refused")

    test 'the refusal names the arguments it rejected' ->

        tooShort = ['ab' 'ocls' 'cd']

        names = (e) -> e.message.includes('ab') and e.message.includes('cd')

        assert.throws((-> run(tooShort)), names)

    test 'nothing is deleted when an argument is too short' ->

        withDb (database) ->
            short = {db: database, prefixes: ['ab'], width: 80, style: plain, io: io('y')}

            assert.throws(-> del(short))
            assert.equal rowCount(database, A), 1

    test 'a three character title argument is accepted' ->

        got = run(['oco'], 'y').deleted
        assert.deepEqual got, [A]

    test 'an unknown id errors before the warning' ->

        assert.throws((-> run(['zzzzzz'])), /no\x20session/i)

    test 'a non-interactive terminal refuses without deleting' ->

        withDb (database) ->
            opt = {db: database, prefixes: ['aaaaaa'], width: 80, style: plain, io: io('y', false)}

            assert.throws((-> del(opt)), throwsOcls(/terminal/i))

#  ███████   ███████   ███   ███  ████████  ███  ████████   ██     ██
# ███       ███   ███  ████  ███  ███       ███  ███   ███  ███   ███
# ███       ███   ███  ███ █ ███  ██████    ███  ███████    █████████
# ███       ███   ███  ███  ████  ███       ███  ███   ███  ███ █ ███
#  ███████   ███████   ███   ███  ███       ███  ███   ███  ███   ███

test.describe 'del confirmation' ->

    test 'shows a warning, the sessions, and the question' ->

        res = run ['aaaaaa']
        text = res.text

        assert.match text, /DELETE\x20SESSIONS/
        assert.match text, /aaaaaa.*Coco\x20-\x20ocls/s
        assert.match text, /ARE\x20YOU\x20SURE\?\x20\(yN\)/

    test 'the warning comes before the session list' ->

        res = run ['aaaaaa']
        text = res.text

        assert.ok text.indexOf('DELETE SESSIONS') < text.indexOf('aaaaaa')
        assert.ok text.indexOf('aaaaaa') < text.indexOf('ARE YOU SURE')

    test 'n aborts without deleting' ->

        res = run ['aaaaaa'], 'n'

        assert.deepEqual res.deleted, []
        assert.match res.text, /nothing\x20deleted/i

    test 'empty input aborts' ->

        empty = run(['aaaaaa'], '').deleted
        assert.deepEqual empty, []

    test 'anything other than y aborts' ->

        maybe = run(['aaaaaa'], 'maybe').deleted
        assert.deepEqual maybe, []

    test 'yes is accepted too' ->

        agreed = run(['aaaaaa'], 'yes').deleted
        assert.equal agreed.length, 1

# ███████    ████████  ███      ████████  █████████  ███   ███████   ███   ███
# ███   ███  ███       ███      ███          ███     ███  ███   ███  ████  ███
# ███   ███  ███████   ███      ███████      ███     ███  ███   ███  ███ █ ███
# ███   ███  ███       ███      ███          ███     ███  ███   ███  ███  ████
# ███████    ████████  ███████  ████████     ███     ███   ███████   ███   ███

test.describe 'del deletion' ->

    test 'accepts a title argument and deletes what it matched' ->

        withDb (database) ->
            del {db: database, prefixes: ['ocls'], width: 80, style: plain, io: io('y')}
            assert.equal rowCount(database, A), 0
            assert.equal rowCount(database, C), 1

    test 'accepts a mix of ids and titles' ->

        withDb (database) ->
            both = ['aaaaaaa' 'ocls']
            del {db: database, prefixes: both, width: 80, style: plain, io: io('y')}
            assert.equal rowCount(database, A), 0

    test 'removes the session row' ->

        withDb (database) ->
            deleteA database
            assert.equal rowCount(database, A), 0

    test 'cascades to all five child tables' ->

        withDb (database) ->

            before = build.countRows database, A

            every = Object.values before
            assert.ok every.every((n) -> n > 0),
                "fixture should populate every child table, got #{JSON.stringify(before)}"

            deleteA database

            for entry in Object.entries(build.countRows(database, A))
                assert.equal entry[1], 0, "#{entry[0]} kept #{entry[1]} rows"

    test 'leaves other sessions and their children alone' ->

        withDb (database) ->
            deleteA database
            assert.equal rowCount(database, C), 1
            others = Object.values build.countRows(database, C)
            assert.ok others.every((n) -> n > 0)

    test 'reports what it deleted, in the ids given' ->

        both = run(['aaaaaa', 'cccccc']).deleted
        assert.deepEqual both, [A, C]

    test 'an aborted delete leaves the rows untouched' ->

        withDb (database) ->
            deleteA database, 'n'
            assert.equal rowCount(database, A), 1

###
    ███████    ████████  ███    
    ███   ███  ███       ███    
    ███   ███  ███████   ███    
    ███   ███  ███       ███    
    ███████    ████████  ███████
###

use ../test/fixtures/build
use .. ◆ db del style
use ./utils ▪ matches throws

plain = style.createStyle false

A = 'ses_aaaaaaaaaaaaaaaaaaaaaaaaa1'
C = 'ses_ccccccccccccccccccccccc3'

#  A terminal that answers from a list and remembers what was written.

io = (answer='y', interactive=true) ->

    out = []
    answers = answer.split ''

    write = (text) -> out.push text
    readAnswer = -> if answers.length then answers.shift() else undefined

    output = -> out.join ''

    interactive: interactive
    write: write
    readAnswer: readAnswer
    output: output

#  The close is written out on both paths rather than in a finally: a finally
#  block that ends with an expression returns it, which would swallow the throw
#  this helper exists to let through.

run = (ids, answer='y', width=80) ->

    terminal = io answer
    database = db.openWritable build.buildTestDb()

    try
        res = del {db: database, prefixes: ids, width, style: plain, io: terminal}
        out = deleted: res.deleted, text: terminal.output()
    catch err
        database.close()
        throw err

    database.close()
    out

withDb = (fn) ->

    database = db.openWritable build.buildTestDb()

    try
        out = fn database
    catch err
        database.close()
        throw err

    database.close()
    out

deleteA = (database, answer='y') ->
    del {db: database, prefixes: ['aaaaaa'], width: 80, style: plain, io: io(answer)}

rowCount = (database, id) ->
    database.prepare('SELECT count(*) AS c FROM session_v2 WHERE id = ?').get(id).c

#  Named, because an arrow as an argument of assert.throws is more than the
#  parser wants to read: a second arrow on the same statement flattens.

throwsOcls = (pattern) -> (e) -> e instanceof db.OclsError and (pattern.test(e.message))

#  The class itself cannot be handed to throws: a matcher is passed to compare
#  once it has answered, and compare calls a function. Calling a class throws.
#  An instanceof predicate is the same check assert.throws made of the class.

isOcls = (e) -> e instanceof db.OclsError

▸ openWritable

    ▸ can actually write

        withDb (database) ->
            database.prepare('DELETE FROM session_v2 WHERE id = ?').run A
            rowCount(database, A) ▸ 0

    ▸ has foreign keys enforced

        withDb (database) ->
            pragma = database.prepare('PRAGMA foreign_keys').get()
            pragma.foreign_keys ▸ 1

    ▸ rejects a bad schema the same way openDb does

        throws((-> db.openWritable('/nonexistent/opencode.db')), isOcls)

▸ del guards

    ▸ no ids is an error, and nothing is printed first

        throws((-> run([])), throwsOcls(/id/i))

    ▸ an argument shorter than three characters is refused

        for short in ['a' 'ab']
            refused = throwsOcls /at\x20least\x203\x20characters/i
            #  an arrow as the first argument swallows the ones after it, so it
            #  is parenthesised; and a string with escaped quotes is a lexer
            #  hazard, so the message has none.

            throws((-> run([short])), refused)

    ▸ the refusal names the arguments it rejected

        tooShort = ['ab' 'ocls' 'cd']

        names = (e) -> e.message? and e.message.includes('ab') and e.message.includes('cd')

        throws((-> run(tooShort)), names)

    ▸ nothing is deleted when an argument is too short

        withDb (database) ->
            short = {db: database, prefixes: ['ab'], width: 80, style: plain, io: io('y')}

            throws(-> del(short))
            rowCount(database, A) ▸ 1

    ▸ a three character title argument is accepted

        got = run(['oco'], 'y').deleted
        got ▸ [A]

    ▸ an unknown id errors before the warning

        throws((-> run(['zzzzzz'])), /no\x20session/i)

    ▸ a non-interactive terminal refuses without deleting

        withDb (database) ->
            opt = {db: database, prefixes: ['aaaaaa'], width: 80, style: plain, io: io('y', false)}

            throws((-> del(opt)), throwsOcls(/terminal/i))

#  ███████   ███████   ███   ███  ████████  ███  ████████   ██     ██
# ███       ███   ███  ████  ███  ███       ███  ███   ███  ███   ███
# ███       ███   ███  ███ █ ███  ██████    ███  ███████    █████████
# ███       ███   ███  ███  ████  ███       ███  ███   ███  ███ █ ███
#  ███████   ███████   ███   ███  ███       ███  ███   ███  ███   ███

▸ del confirmation

    ▸ shows a warning, the sessions, and the question

        res = run ['aaaaaa']
        text = res.text

        matches text, /DELETE\x20SESSIONS/
        matches text, /aaaaaa.*Coco\x20-\x20ocls/s
        matches text, /ARE\x20YOU\x20SURE\?\x20\(yN\)/

    ▸ the warning comes before the session list

        res = run ['aaaaaa']
        text = res.text

        text.indexOf('DELETE SESSIONS') < text.indexOf('aaaaaa') ▸ yes
        text.indexOf('aaaaaa') < text.indexOf('ARE YOU SURE') ▸ yes

    ▸ n aborts without deleting

        res = run ['aaaaaa'], 'n'

        res.deleted ▸ []
        matches res.text, /nothing\x20deleted/i

    ▸ empty input aborts

        empty = run(['aaaaaa'], '').deleted
        empty ▸ []

    ▸ anything other than y aborts

        maybe = run(['aaaaaa'], 'maybe').deleted
        maybe ▸ []

    ▸ yes is accepted too

        agreed = run(['aaaaaa'], 'yes').deleted
        agreed.length ▸ 1

# ███████    ████████  ███      ████████  █████████  ███   ███████   ███   ███
# ███   ███  ███       ███      ███          ███     ███  ███   ███  ████  ███
# ███   ███  ███████   ███      ███████      ███     ███  ███   ███  ███ █ ███
# ███   ███  ███       ███      ███          ███     ███  ███   ███  ███  ████
# ███████    ████████  ███████  ████████     ███     ███   ███████   ███   ███

▸ del deletion

    ▸ accepts a title argument and deletes what it matched

        withDb (database) ->
            del {db: database, prefixes: ['ocls'], width: 80, style: plain, io: io('y')}
            rowCount(database, A) ▸ 0
            rowCount(database, C) ▸ 1

    ▸ accepts a mix of ids and titles

        withDb (database) ->
            both = ['aaaaaaa' 'ocls']
            del {db: database, prefixes: both, width: 80, style: plain, io: io('y')}
            rowCount(database, A) ▸ 0

    ▸ removes the session row

        withDb (database) ->
            deleteA database
            rowCount(database, A) ▸ 0

    ▸ cascades to all five child tables

        withDb (database) ->

            before = build.countRows database, A

            every = Object.values before
            every.every((n) -> n > 0) ▸ yes

            deleteA database

            for entry in Object.entries(build.countRows(database, A))
                entry[1] ▸ 0

    ▸ leaves other sessions and their children alone

        withDb (database) ->
            deleteA database
            rowCount(database, C) ▸ 1
            others = Object.values build.countRows(database, C)
            others.every((n) -> n > 0) ▸ yes

    ▸ reports what it deleted, in the ids given

        both = run(['aaaaaa', 'cccccc']).deleted
        both ▸ [A, C]

    ▸ an aborted delete leaves the rows untouched

        withDb (database) ->
            deleteA database, 'n'
            rowCount(database, A) ▸ 1

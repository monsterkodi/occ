import sqlite from 'node:sqlite'

use ./fixtures/build
use .. ◆ db query ls style
use ./utils ▪ throws

DB_PATH = build.fixtures().DB_PATH

plain = style.createStyle false

run = (args, width=80) ->

    database = db.openDb DB_PATH
    ls {db: database, prefixes: args, width, style: plain}

runOn = (database, args=[], width=80) -> ls {db: database, prefixes: args, width, style: plain}

#  a db whose sessions fall on known days, for the date-grouping cases

daysDb = ->

    database = new sqlite.DatabaseSync ':memory:'

    database.exec """
      CREATE TABLE session_v2 (
        id text PRIMARY KEY, parent_id text, title text, directory text,
        time_created integer NOT NULL, time_updated integer NOT NULL
      );
      CREATE TABLE session_message (
        id text PRIMARY KEY, session_id text NOT NULL, type text NOT NULL,
        seq integer NOT NULL, time_created integer NOT NULL, data text NOT NULL
      );
    """

    insert = database.prepare "INSERT INTO session_v2 (id, parent_id, title, directory, time_created, time_updated) VALUES (?, ?, ?, ?, ?, ?)"
    message = database.prepare "INSERT INTO session_message (id, session_id, type, seq, time_created, data) VALUES (?, ?, ?, ?, ?, ?)"

    at = (month, date, hours) -> (new Date 2026, month - 1, date, hours, 0, 0, 0).getTime()

    #  distinct leading characters, so a short prefix picks exactly one session

    rows = [
        ['1111', 10, 7, 11, 'same day first']
        ['2222', 10, 7, 12, 'same day second']
        ['3333', 10, 11, 8, 'next day first']
        ['4444', 10, 11, 14, 'next day second']
        ['5555', 10, 13, 1, 'third day']
    ]

    for row in rows
        id = "ses_#{row[0]}#{'0'.repeat 21}"
        last = at(row[1], row[2], row[3])
        insert.run id, null, row[4], '/home/kodi/a/coco', last - 3600000, last
        message.run "m_#{row[0]}", id, 'user', 1, last, JSON.stringify({text: 'hi'})

    database

#  day of the day.month part, from a stamp the row rendered

dateOf = (line) ->
    m = (/^\x20\w{6}\x20+(\d\d\.\d\d)/).exec line
    if m == null then ⮐ undefined
    m[1]

timeOf = (line) ->
    m = (/^\x20\w{6}\x20+(?:\d\d\.\d\d)?\x20*(\d\d:\d\d)/).exec line
    if m == null then ⮐ undefined
    m[1]

at_ = (line, text) -> line.indexOf text

stamp = (ms) ->

    d = new Date ms
    pad = (n) -> String(n).padStart 2, '0'

    "#{pad(d.getDate())}.#{pad(d.getMonth() + 1)} #{pad(d.getHours())}:#{pad(d.getMinutes())}"

▸ ls date grouping

    ▸ a session repeating the previous row's date shows spaces instead

        lines = runOn(daysDb()).split('\n')

        (dateOf(lines[0])) ▸ '07.10'
        (dateOf(lines[1])) ▸ undefined
        (dateOf(lines[2])) ▸ '11.10'
        (dateOf(lines[3])) ▸ undefined
        (dateOf(lines[4])) ▸ '13.10'

    ▸ the time is still printed on a blanked row

        lines = runOn(daysDb()).split('\n')
        (lines.map(timeOf)) ▸ ['11:00' '12:00' '08:00' '14:00' '01:00']

    ▸ every row keeps its full width when the date is blanked

        for line in runOn(daysDb()).split('\n')
            line.length ▸ 80

    ▸ the hour is in the same column on blanked and dated rows

        lines = runOn(daysDb()).split('\n')

        (at_(lines[1], '12:00')) ▸ (at_(lines[0], '11:00'))
        (at_(lines[3], '14:00')) ▸ (at_(lines[2], '08:00'))

    ▸ ids are listed with every date shown

        lines = runOn(daysDb(), ['2222', '4444']).split('\n')
        (lines.map(dateOf)) ▸ ['07.10' '11.10']

    ▸ a title argument lists with every date shown

        lines = runOn(daysDb(), ['same day']).split('\n')
        (lines.map(dateOf)) ▸ ['07.10' '07.10']

    ▸ one row only shows its date

        rows = runOn(daysDb(), ['1111']).split '\n'
        (dateOf(rows[0])) ▸ '07.10'

    ▸ a session with no messages groups on its update time

        database = daysDb()

        stmt = database.prepare "INSERT INTO session_v2 (id, parent_id, title, time_created, time_updated) VALUES (?, ?, ?, ?, ?)"
        created = (new Date 2026, 8, 13, 1, 0, 0, 0).getTime()
        updated = (new Date 2026, 9, 7, 12, 30, 0, 0).getTime()

        stmt.run 'ses_0000000000000000000000006', null, 'no messages', created, updated

        #  sorts between the two 07.10 sessions, on its update time of 12:30

        lines = runOn(database).split('\n')

        (lines.map(timeOf)) ▸ ['11:00' '12:00' '12:30' '08:00' '14:00' '01:00']
        (lines.map(dateOf)) ▸ ['07.10' undefined undefined '11.10' undefined '13.10']

        database.close()

    ▸ the shared fixture groups too

        lines = run([]).split('\n')
        dates = lines.map dateOf
        first = dates.indexOf undefined

        first == -1 or first > 0 ▸ yes

▸ ls

    ▸ no ids lists every session, one row each

        (run([]).split('\n').length) ▸ 3

    ▸ ids filter the rows

        lines = run(['bbbbbb']).split('\n')

        lines.length ▸ 1
        (lines[0].trimStart().startsWith('bbbbbb')) ▸ yes

    ▸ a title argument selects rows too

        lines = run(['ocls']).split('\n')

        lines.length ▸ 1
        (lines[0].includes('Coco - ocls')) ▸ yes

    ▸ ids and titles can be mixed

        (run(['ocls', 'bbbbbb']).split('\n').length) ▸ 2

    ▸ unknown id surfaces the error

        throws (-> run(['zzzzzz'])), /no\x20session/i

    ▸ output ends without a trailing blank line

        every = run []
        not (every.endsWith('\n')) ▸ yes

    ▸ the date column shows the last turn, not the session start

        sessions = query.listSessions(db.openDb(DB_PATH), ['aaaaaa'])
        rows = run(['aaaaaa']).split('\n')

        (rows[0].includes(stamp(sessions[0].time_last))) ▸ yes
        not (rows[0].includes(stamp(sessions[0].time_created))) ▸ yes

    ▸ each row adds up: last turn minus duration is the session start

        sessions = query.listSessions db.openDb(DB_PATH), []
        rows = run([]).split('\n')

        rows.length ▸ sessions.length

        checked = sessions.filter (s) -> s.time_last >= s.time_created
        checked.length > 0 ▸ yes

        for session in checked
            i = sessions.indexOf session
            m = (/^\x20\w{6}\x20+(?:\d\d\.\d\d)?\x20*\d\d:\d\d\x20+(\d+)\x20/).exec rows[i]
            start = new Date session.time_last - Number(m[1]) * 60000

            Math.abs(start - session.time_created) <= 60000 ▸ yes

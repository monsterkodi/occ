import test from 'node:test'
import assert from 'node:assert/strict'

use ./fixtures/build
use ../db
use ../shell
use ../log
use ../ls
use ../render
use ../escape
use ../style

CONTROL_DB_PATH = build.fixtures().CONTROL_DB_PATH

plain = style.createStyle false

#  every byte an escape function has to deal with: nul, the C0 controls that
#  are not tab, newline or the escape byte, and delete

CONTROL_BYTES = /[\0-\x08\x0b-\x1a\x1c-\x1f\x7f]/

#  log is the console builtin, so the module answers to a second name

history = log

run = (command) ->

    database = db.openDb CONTROL_DB_PATH

    if command == history then history({db: database, prefixes: ['eeeeee'], width: 80, style: plain})
    command({db: database, prefixes: ['eeeeee'], width: 80, style: plain})

bytesOf = (text) -> Array.from Buffer.from(text, 'utf8')


test.describe 'escapeControl' ->

    test 'leaves printable text alone' ->

        assert.equal escape('plain text 123 !?'), 'plain text 123 !?'

    test 'keeps tab and newline, since they are layout, not noise' ->

        assert.equal escape("a\tb\nc"), "a\tb\nc"

    test 'escapes nul as a hex byte' ->

        assert.equal escape("a\0b"), 'a\\x00b'

    test 'escapes every other c0 control as hex' ->

        all = Array.from({length: 0x20}, (_, i) -> String.fromCharCode(i))
        c0 = all.filter((c) -> not ("\t\n\u001b").includes(c)).join ''

        for c in c0
            hex = c.charCodeAt(0).toString(16).padStart 2, '0'
            assert.equal escape("a#{c}b"), "a\\x#{hex}b", "charcode #{c.charCodeAt(0)}"

    test 'escapes delete' ->

        assert.equal escape("a\u007fb"), 'a\\x7fb'

    test 'keeps the ansi escape byte, since colors are output to keep' ->

        assert.equal escape("\u001b[31mred\u001b[39m"), "\u001b[31mred\u001b[39m"

    test 'leaves multibyte text untouched' ->

        assert.equal escape('héllo → 🎉'), 'héllo → 🎉'

    test 'coerces a non-string' ->

        assert.equal escape(42), '42'
        assert.equal escape(null), 'null'

    test 'output never carries a control byte other than tab and newline' ->

        for c in Array.from({length: 0x80}, (_, i) -> String.fromCharCode(i))
            out = escape "a#{c}b"
            bad = bytesOf(out).filter (b) ->
                if b == 0x09 or b == 0x0a or b == 0x1b then false else b < 0x20 or b == 0x7f
            assert.deepEqual bad, [], "charcode #{c.charCodeAt(0)} leaked"


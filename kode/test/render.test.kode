###
    ████████   ████████  ███   ███  ███████    ████████  ████████   
    ███   ███  ███       ████  ███  ███   ███  ███       ███   ███  
    ███████    ███████   ███ █ ███  ███   ███  ███████   ███████    
    ███   ███  ███       ███  ████  ███   ███  ███       ███   ███  
    ███   ███  ████████  ███   ███  ███████    ████████  ███   ███  
###

import test from 'node:test'
import assert from 'node:assert/strict'

use ../render
use ../style

plain = style.createStyle false
colored = style.createStyle true

MINUTE = 60000

session =
    id: 'ses_aaaaaaaaaaaa'
    title: 'First session'
    time_created: 1791283494422
    time_updated: 1791283494422 + MINUTE
    time_last: 1791283494422 + MINUTE
    turns: 2

strip = (text) -> text.replace /\x1b\[[0-9;]*m/g, ''

row = (over={}, width=80, color=plain, options=undefined) ->

    merged = Object.assign {}, session, over
    render.renderSession merged, width, color, options

# ███████    ███   ███  ████████    ███████   █████████  ███   ███████   ███   ███
# ███   ███  ███   ███  ███   ███  ███   ███     ███     ███  ███   ███  ████  ███
# ███   ███  ███   ███  ███████    █████████     ███     ███  ███   ███  ███ █ ███
# ███   ███  ███   ███  ███   ███  ███   ███     ███     ███  ███   ███  ███  ████
# ███████     ███████   ███   ███  ███   ███     ███     ███   ███████   ███   ███

test.describe 'durationMinutes' ->

    test 'is whole minutes, with no unit' ->

        cases = [
            [0, '0']
            [999, '0']
            [59999, '0']
            [60000, '1']
            [60000 + 59999, '1']
            [90000, '1']
            [18 * 60000, '18']
            [59 * 60000, '59']
            [3600000, '60']
            [24 * 3600000, '1440']
            [365 * 86400000, '525600']
        ]

        for [ms, expected] in cases
            out = render.durationMinutes ms
            assert.equal out, expected, "#{ms}ms"
            assert.match out, /^\d+$/

    test 'a negative span reads as zero' ->

        assert.equal render.durationMinutes(-5000), '0'

    test 'six digits covers just under two years' ->

        just = render.durationMinutes 999999 * MINUTE
        over = render.durationMinutes 1000000 * MINUTE

        assert.equal just.length, 6
        assert.equal over.length, 7

#  ███████  ████████   ███████   ███████  ███   ███████   ███   ███
# ███       ███       ███       ███       ███  ███   ███  ████  ███
# ███████   ███████   ███████   ███████   ███  ███   ███  ███ █ ███
#      ███  ███            ███       ███  ███  ███   ███  ███  ████
# ███████   ████████  ███████   ███████   ███   ███████   ███   ███

test.describe 'renderSession' ->

    test 'id has the ses_ prefix stripped and is cropped to 6' ->

        assert.match strip(row()), /^\x20aaaaaa\x20/

    test 'last is day.month hour:minute, 11 chars' ->

        assert.match strip(row()), /^\x20aaaaaa\x20+\d\d\.\d\d\x20\d\d:\d\d\x20/

    test 'last reads the time of the last turn, not the start' ->

        out = strip row({time_last: 1791283494422 + 24 * 3600000})
        assert.ok out.startsWith(" aaaaaa  07.10 12:44 "), JSON.stringify out.slice(0, 24)

    test 'a session without a last turn falls back to its update time' ->

        out = strip row({time_last: undefined})
        assert.ok out.startsWith(" aaaaaa  06.10 12:45 "), JSON.stringify out.slice(0, 24)

    test 'null title prints NULL' ->

        out = strip row({title: null})
        assert.match out, /\x20NULL/

    test 'every cell is inset by one space on each side' ->

        out = strip row({title: 'zz'})
        assert.ok out.startsWith(" aaaaaa  06.10 12:45 "), JSON.stringify out.slice(0, 24)
        assert.ok out.includes("zz  "), JSON.stringify out.slice(0, 40)
        assert.equal out.length, 80

    test 'the fixed columns are 34 wide and do not move with the terminal' ->

        fixed = (text) ->
            line = strip row({title: 'z'}, text)
            line.slice 0, 35

        assert.equal fixed(40), fixed(120)
        assert.equal fixed(80).length, 35

    test 'the duration column holds six digits of minutes' ->

        out = strip row({time_last: 1791283494422 + 999999 * MINUTE})
        assert.match out, /\s999999\s/

    test 'duration measures to the last message, not the update time' ->

        out = strip row({time_last: 1791283494422 + 5 * MINUTE})
        assert.match out, /\s5\s/, JSON.stringify out.slice(0, 32)

    test 'a session without a last turn measures to its update time' ->

        out = strip row({time_last: undefined})
        assert.match out, /\s1\s/, JSON.stringify out.slice(0, 32)

    test 'the name column fills to the terminal edge' ->

        at80 = strip row({title: 'zz'}, 80)
        at60 = strip row({title: 'zz'}, 60)

        assert.equal at80.length, 80
        assert.equal at60.length, 60

    test 'a long name is cropped inside the name column' ->

        out = strip row({title: ('x').repeat 200}, 50)

        assert.ok out.includes('…'), out
        assert.equal out.length, 50

    test 'the row fills the terminal, or falls back to its minimum width' ->

        for width in [38 40 60 120]
            out = strip row({title: ('y').repeat 200}, width)
            assert.ok out.length <= width, "width #{width} produced #{out.length}"

        narrow = strip row({}, 20)
        normal = strip row({}, 80)

        assert.equal narrow.length, 37
        assert.equal normal.length, 80

#  day of the day.month part, from a stamp the row rendered

dateOf = (text) ->

    m = (/^\x20(\w{6}\x20+)(\d\d\.\d\d)/).exec strip(text)

    #  Spelled out rather than `m ? m[2]`: next to an index expression the ? is
    #  read as the ternary, not as ??. The javascript is `m?.[2]`.

    if m == null then ⮐ undefined
    m[2]

day = (month, date, hours, minutes) ->
    (new Date 2026, month - 1, date, hours, minutes, 0, 0).getTime()

test.describe 'renderSession repeatDate' ->

    test 'a repeated date renders as spaces, the time stays in its column' ->

        out = row({time_last: day(10, 7, 11, 0)}, 80, plain, {repeatDate: true})

        assert.match strip(out), /^\x20aaaaaa\x20+\x20{6}\d\d:\d\d\x20/, JSON.stringify(strip(out).slice 0, 24)

    test 'the hour sits in the same column with and without a date' ->

        blanked = strip row({time_last: day(10, 7, 11, 0)}, 80, plain, {repeatDate: true})
        shown = strip row({time_last: day(10, 7, 11, 0)}, 80, plain, {repeatDate: false})

        assert.equal blanked.indexOf('11:00'), shown.indexOf('11:00')

    test 'the date is printed when repeatDate is not set' ->

        out = row({time_last: day(10, 7, 11, 0)}, 80, plain, {repeatDate: false})
        assert.equal dateOf(out), '07.10'

    test 'the row keeps its width and its cell positions with a repeated date' ->

        blanked = row({time_last: day(10, 7, 11, 0)}, 80, plain, {repeatDate: true})
        shown = row({time_last: day(10, 7, 11, 0)}, 80, plain, {repeatDate: false})

        assert.equal blanked.length, shown.length
        assert.equal strip(blanked).length, 80
        assert.equal strip(blanked).slice(21), strip(shown).slice(21)
        assert.equal strip(blanked), strip(shown).replace('07.10', '     ')

    test 'colors wrap the blanked date like any other cell' ->

        custom = style.createStyle true
        background = (text) -> "\u001b[44m#{text}\u001b[49m"
        custom.row.last = background

        out = row({time_last: day(10, 7, 11, 0)}, 80, custom, {repeatDate: true})

        assert.ok out.includes("\u001b[44m"), 'the cell lost its background'
        assert.equal strip(out).length, 80

# ████████    ███████   ███████    ███████    ███  ███   ███   ███████ 
# ███   ███  ███   ███  ███   ███  ███   ███  ███  ████  ███  ███      
# ████████   █████████  ███   ███  ███   ███  ███  ███ █ ███  ███  ████
# ███        ███   ███  ███   ███  ███   ███  ███  ███  ████  ███   ███
# ███        ███   ███  ███████    ███████    ███  ███   ███   ███████ 

background = (text) -> "\u001b[44m#{text}\u001b[49m"

test.describe 'renderSession padding' ->

    test 'cell padding sits inside the role, so a background reaches the gap' ->

        custom = style.createStyle true
        custom.row.id = background
        custom.row.last = background

        out = row {}, 80, custom

        assert.ok out.startsWith("\u001b[44m aaaaaa "), JSON.stringify out.slice(0, 20)

    test 'no space between two cells is left unstyled' ->

        custom = style.createStyle true

        for key in ['id' 'last' 'duration' 'turns' 'name']
            custom.row[key] = background

        out = row {}, 80, custom
        bare = strip out

        i = 1
        while i < bare.length
            if bare[i] != ' ' then i += 1
            assert.ok out.includes("\u001b[44m"), "space at #{i} sits outside a background"
            i += 1

    test 'a fully backgrounded row has the same visible text as a plain one' ->

        custom = style.createStyle true

        for key in ['id' 'last' 'duration' 'turns' 'name']
            custom.row[key] = background

        assert.equal strip(row({}, 80, custom)), strip(row({}, 80))

#  ███████   ███████   ███       ███████   ████████    ███████
# ███       ███   ███  ███      ███   ███  ███   ███  ███     
# ███       ███   ███  ███      ███   ███  ███████    ███████ 
# ███       ███   ███  ███      ███   ███  ███   ███       ███
#  ███████   ███████   ███████   ███████   ███   ███  ███████ 

test.describe 'renderSession colors' ->

    test 'colors do not shift or truncate the visible text' ->

        assert.equal strip(row({}, 80, colored)), strip(row())

        for width in [40 80 120]
            withColor = row {}, width, colored
            assert.equal strip(withColor).length, (strip row({}, width)).length
            assert.ok strip(withColor).length <= width

    test 'a colored long name still ends at the terminal edge' ->

        out = strip row({title: ('q').repeat 200}, 50, colored)

        assert.equal out.length, 50
        assert.ok out.includes '…'

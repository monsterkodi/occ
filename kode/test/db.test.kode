#  where the database is, and what happens when it is not the database we asked
#  for.

import test from 'node:test'
import assert from 'node:assert/strict'

use ./fixtures/build
use ../db

fx = build.fixtures()

DB_PATH = fx.DB_PATH
BAD_SCHEMA_DB_PATH = fx.BAD_SCHEMA_DB_PATH
MISSING_COLUMN_DB_PATH = fx.MISSING_COLUMN_DB_PATH

throwsOclsError = (pattern) -> (e) -> e instanceof db.OclsError and (pattern.test e.message)

test.describe 'resolveDbPath' ->

    test 'uses XDG_DATA_HOME when set' ->

        assert.equal db.resolveDbPath({XDG_DATA_HOME: '/xdg'}), '/xdg/opencode/opencode.db'

    test 'falls back to ~/.local/share' ->

        assert.equal db.resolveDbPath({}), "#{process.env.HOME}/.local/share/opencode/opencode.db"

test.describe 'openDb' ->

    test 'opens the fixture read-only' ->

        d = db.openDb DB_PATH

        assert.equal (d.prepare('SELECT count(*) c FROM session_v2').get()).c, 4
        assert.throws(-> d.prepare('DELETE FROM session_v2').run(), /readonly/i)

        d.close()

    test 'missing file gives a clear error' ->

        assert.throws(-> db.openDb('/nonexistent/opencode.db'), throwsOclsError(/no\x20database/i))

    test 'unrecognized schema gives a clear error' ->

        assert.throws(-> db.openDb(BAD_SCHEMA_DB_PATH), throwsOclsError(/schema/i))

    test 'missing required column gives a clear error' ->

        assert.throws(-> db.openDb(MISSING_COLUMN_DB_PATH), throwsOclsError(/time_updated/))
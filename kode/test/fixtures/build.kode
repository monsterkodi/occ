#  the databases the suite runs against, built from scratch in a temp directory.
#
#  A call cannot be spread, so `insert.run(...msg(id, A, 'user', 1, {...}))`
#  becomes run(insert, msg(...)). The receiver is the statement rather than
#  null: node:sqlite's run is a native method and rejects a null this.

import sqlite from 'node:sqlite'
import fs from 'node:fs'
import path from 'node:path'
import os from 'node:os'
import url from 'node:url'

here = path.dirname(url.fileURLToPath(import.meta.url))

BASE = 1791283494422

SESSION_DDL = """
  CREATE TABLE session_v2 (
    id text PRIMARY KEY,
    project_id text NOT NULL,
    parent_id text,
    title text,
    slug text NOT NULL,
    directory text NOT NULL,
    time_created integer NOT NULL,
    time_updated integer NOT NULL
  )
"""

CHILD_DDL = """
  CREATE TABLE session_message (
    id text PRIMARY KEY,
    session_id text NOT NULL,
    type text NOT NULL,
    seq integer NOT NULL,
    time_created integer NOT NULL,
    time_updated integer NOT NULL,
    data text NOT NULL,
    FOREIGN KEY (session_id) REFERENCES session_v2(id) ON DELETE CASCADE
  );

  CREATE TABLE session_pending (
    id text PRIMARY KEY,
    session_id text NOT NULL,
    type text NOT NULL,
    data text NOT NULL,
    delivery text NOT NULL,
    admitted_seq integer NOT NULL,
    time_created integer NOT NULL,
    FOREIGN KEY (session_id) REFERENCES session_v2(id) ON DELETE CASCADE
  );

  CREATE TABLE session_inbox (
    id text PRIMARY KEY,
    session_id text NOT NULL,
    type text NOT NULL,
    payload text NOT NULL,
    delivery text NOT NULL,
    enqueued_seq integer NOT NULL,
    time_created integer NOT NULL,
    FOREIGN KEY (session_id) REFERENCES session_v2(id) ON DELETE CASCADE
  );

  CREATE TABLE instruction_entry (
    session_id text NOT NULL,
    key text NOT NULL,
    value text NOT NULL,
    removed integer NOT NULL DEFAULT 0,
    time_created integer NOT NULL,
    time_updated integer NOT NULL,
    PRIMARY KEY (session_id, key),
    FOREIGN KEY (session_id) REFERENCES session_v2(id) ON DELETE CASCADE
  );

  CREATE TABLE instruction_state (
    session_id text PRIMARY KEY,
    epoch_start integer NOT NULL,
    through_seq integer NOT NULL,
    initial_values text NOT NULL,
    current_values text NOT NULL,
    FOREIGN KEY (session_id) REFERENCES session_v2(id) ON DELETE CASCADE
  );
"""

CHILD_TABLES = [
    'session_message'
    'session_pending'
    'session_inbox'
    'instruction_entry'
    'instruction_state'
    ]

A = 'ses_aaaaaaaaaaaaaaaaaaaaaaaaa1'
C = 'ses_ccccccccccccccccccccccc3'

countRows = (db, sessionId) ->

    counts = CHILD_TABLES.map (table) ->
        row = db.prepare("SELECT count(*) AS c FROM #{table} WHERE session_id = ?").get(sessionId)
        [table, row.c]

    Object.fromEntries counts

run = (stmt, args) -> stmt.run.apply(stmt, args)

msg = (id, sessionId, type, seq, payload) ->

    at = BASE + seq * 1000
    [id, sessionId, type, seq, at, at, JSON.stringify(payload)]

text = (t) -> {type: 'text', text: t}

reasoning = (t) -> {type: 'reasoning', text: t}

tool = (name, input, opt={}) ->

    state = status: opt.status ? 'completed', input: input

    #  `!= undefined` and not `valid`: an empty result is a result, and this
    #  fixture has one.

    if opt.error != undefined
        state.error = {type: 'unknown', message: opt.error}
    else if opt.result != undefined
        state.content = [{type: 'text', text: opt.result}]

    state.metadata = Object.assign {exit: opt.exit ? 0}, opt.metadata

    {type: 'tool', id: "call_#{name}", name, state}

seedSessions = (db) ->

    insert = db.prepare "INSERT INTO session_v2 (id, project_id, parent_id, title, slug, directory, time_created, time_updated) VALUES (?, ?, ?, ?, ?, ?, ?, ?)"

    insert.run A, 'proj1', null, 'Coco - ocls', 'witty-knight', '/home/kodi/a/coco', BASE, BASE + 60000
    insert.run 'ses_bbbbbbbbbbbbbbbbbbbbbbb2', 'proj1', null, null, 'happy-meadow', '/home/kodi/.config', BASE + 120000, BASE + 180000
    insert.run C, 'proj1', null, 'Conny - hyprsession', 'brave-otter', '/home/kodi/s/occ', BASE + 240000, BASE + 300000
    insert.run 'ses_ddddddddddddddddddddddd4', 'proj1', A, 'Bert - child', 'quiet-fox', '/home/kodi/a/coco', BASE + 360000, BASE + 420000

seedMessages = (db) ->

    insert = db.prepare "INSERT INTO session_message (id, session_id, type, seq, time_created, time_updated, data) VALUES (?, ?, ?, ?, ?, ?, ?)"

    run insert, msg('m1', A, 'user', 1, {text: 'hello'})

    run insert, msg('m2', A, 'assistant', 2, {
        agent: 'plan'
        #  parens on every call inside the array: juxtaposition flattens into
        #  the array rather than nesting, so [text 'a', text 'b'] would be four
        #  elements.

        content: [
            reasoning('thinking about the greeting')
            text('hi there')
            tool('shell', {command: 'ls -la; echo ---; hyprctl version'}, {result: "total 48\n---\nHyprland 0.56.2"})
            text('done listing')
        ]
    })

    run insert, msg('m3', A, 'user', 3, {text: 'again'})

    run insert, msg('m4', A, 'assistant', 4, {
        agent: 'build'
        content: [text('first bit'), text('second bit')]
    })

    run insert, msg('m5', A, 'assistant', 5, {
        content: [text('no agent field')]
    })

    run insert, msg('m6', A, 'assistant', 6, {
        agent: 'plan'
        content: [
            reasoning('only thinking')
            tool('shell', {command: 'true'}, {result: ''})
            tool('webfetch', {url: 'https://example.invalid'}, {error: 'StatusCode: non 2xx status code (404)'})
            tool('grep', {pattern: 'needle'}, {status: 'running'})
            tool('read', {path: '/home/kodi/s/occ/spec.txt'}, {
                result: "name: occ\n"
                metadata: {truncated: 1, outputPath: '/home/kodi/.local/share/opencode/tool-output/tool_abc'}
            })
        ]
    })

    run insert, msg('m7', A, 'synthetic', 7, {text: 'system note'})
    run insert, msg('m8', 'ses_bbbbbbbbbbbbbbbbbbbbbbb2', 'idle', 1, {outcome: 'prompt-input'})
    run insert, msg('m9', 'ses_bbbbbbbbbbbbbbbbbbbbbbb2', 'user', 2, {text: ''})

    run insert, msg('m10', C, 'user', 1, {text: 'one'})

    run insert, msg('m11', C, 'assistant', 2, {
        agent: 'build'
        content: [tool('shell', {command: 'echo hi'}, {result: "hi\n"})]
    })

    run insert, msg('m12', C, 'assistant', 3, {
        agent: 'build'
        content: [
            tool('shell', {command: "cat > x <<'EOF'\nline\nEOF"}, {result: ''})
            text('after the tool')
        ]
    })

    run insert, msg('m13', C, 'assistant', 4, {
        agent: 'build'
        content: [tool('shell', {command: 'false'}, {result: 'boom', exit: 42})]
    })

CONTROL_TITLE = 'Nul\0 in\ttitle'

CONTROL_RESULT = [
    "<anonymous_script>:1"
    "\0\0\0 \b\x10\0\x040\0\0"
    ''
    'SyntaxError: Unexpected token \'\\0\', "\\0\\0\\0 \\b\\x10\\0\\040\\0\\0" is not valid JSON'
    'tab\there'
    "color\x1b[31mred\x1b[39m"
    ].join('\n')

CONTROL_SESSION = 'ses_eeeeeeeeeeeeeeeeeeeeeee5'

seedControlBytes = (db) ->

    db.exec SESSION_DDL
    db.exec CHILD_DDL

    insertSession = db.prepare "INSERT INTO session_v2 (id, project_id, parent_id, title, slug, directory, time_created, time_updated) VALUES (?, ?, ?, ?, ?, ?, ?, ?)"

    insertSession.run CONTROL_SESSION, 'proj1', null, CONTROL_TITLE, 'wild-otter', '/home/kodi/s/occ', BASE, BASE + 60000

    payload =
        agent: 'build'
        content: [
            tool('shell', {command: "printf '\\000'"}, {result: CONTROL_RESULT})
        ]

    insertMessage = db.prepare "INSERT INTO session_message (id, session_id, type, seq, time_created, time_updated, data) VALUES (?, ?, ?, ?, ?, ?, ?)"

    insertMessage.run 'c1', CONTROL_SESSION, 'assistant', 1, BASE, BASE, JSON.stringify(payload)

seedChildren = (db) ->

    pending = db.prepare "INSERT INTO session_pending (id, session_id, type, data, delivery, admitted_seq, time_created) VALUES (?, ?, ?, ?, ?, ?, ?)"
    inbox = db.prepare "INSERT INTO session_inbox (id, session_id, type, payload, delivery, enqueued_seq, time_created) VALUES (?, ?, ?, ?, ?, ?, ?)"
    entry = db.prepare "INSERT INTO instruction_entry (session_id, key, value, removed, time_created, time_updated) VALUES (?, ?, ?, ?, ?, ?)"
    state = db.prepare "INSERT INTO instruction_state (session_id, epoch_start, through_seq, initial_values, current_values) VALUES (?, ?, ?, ?, ?)"

    pending.run 'p1', A, 'compaction', '{}', 'direct', 1, BASE
    inbox.run 'i1', A, 'note', '{}', 'direct', 1, BASE
    entry.run A, 'reply', 'short', 0, BASE, BASE
    state.run A, 0, 7, '{}', '{}'

    pending.run 'p2', C, 'compaction', '{}', 'direct', 2, BASE
    inbox.run 'i2', C, 'note', '{}', 'direct', 2, BASE
    entry.run C, 'reply', 'terse', 0, BASE, BASE
    state.run C, 0, 4, '{}', '{}'

seed = (db) ->

    db.exec SESSION_DDL
    db.exec CHILD_DDL
    seedSessions db
    seedMessages db
    seedChildren db

build = (name, fill) ->

    dir = path.join os.tmpdir(), 'occ-fixtures', String(process.pid)
    fs.mkdirSync dir, {recursive: true}

    final = path.join dir, name
    staging = "#{final}.building"

    fs.rmSync staging, {force: true}

    db = new sqlite.DatabaseSync staging

    try
        fill db
    catch err
        throw err
    finally
        db.close()

    fs.renameSync staging, final
    final

buildTestDb = -> build 'test.db', seed

buildBadSchemaDb = ->

    build 'bad-schema.db', (db) ->
        db.exec "CREATE TABLE session_v3 (id text PRIMARY KEY)"

buildMissingColumnDb = ->

    build 'missing-column.db', (db) ->
        db.exec "CREATE TABLE session_v2 (id text PRIMARY KEY, title text, time_created integer NOT NULL)"

buildControlBytesDb = -> build 'control-bytes.db', seedControlBytes

makeDataHome = ->

    source = buildTestDb()
    home = path.join os.tmpdir(), 'occ-data-home', String(process.pid)
    target = path.join home, 'opencode', 'opencode.db'

    fs.mkdirSync path.join(home, 'opencode'), {recursive: true}
    fs.copyFileSync source, target

    home: home
    dbPath: target

cached = null

fixtures = ->

    if cached == null
        cached =
            DB_PATH: buildTestDb()
            BAD_SCHEMA_DB_PATH: buildBadSchemaDb()
            MISSING_COLUMN_DB_PATH: buildMissingColumnDb()
            CONTROL_DB_PATH: buildControlBytesDb()

    cached

export
    BASE: BASE
    CONTROL_TITLE: CONTROL_TITLE
    CONTROL_RESULT: CONTROL_RESULT
    CONTROL_SESSION: CONTROL_SESSION
    countRows: countRows
    buildTestDb: buildTestDb
    buildBadSchemaDb: buildBadSchemaDb
    buildMissingColumnDb: buildMissingColumnDb
    buildControlBytesDb: buildControlBytesDb
    makeDataHome: makeDataHome
    fixtures: fixtures
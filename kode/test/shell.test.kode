 ███████  ███   ███  ████████  ███      ███            ████████  ███  ███      █████████  ████████  ████████   ███  ███   ███   ███████ 
███       ███   ███  ███       ███      ███            ███       ███  ███         ███     ███       ███   ███  ███  ████  ███  ███      
███████   █████████  ███████   ███      ███            ██████    ███  ███         ███     ███████   ███████    ███  ███ █ ███  ███  ████
     ███  ███   ███  ███       ███      ███            ███       ███  ███         ███     ███       ███   ███  ███  ███  ████  ███   ███
███████   ███   ███  ████████  ███████  ███████        ███       ███  ███████     ███     ████████  ███   ███  ███  ███   ███   ███████ 
###

test.describe 'shell filtering' ->

    test 'shows no user turns and no continuation ellipses' ->

        out = run ['cccccc']

        assert.ok not out.includes '> user'
        assert.ok not out.includes "\n…"
        assert.ok not out.includes 'one'

    test 'only shell tools are shown' ->

        out = run ['aaaaaa']

        assert.ok out.includes '$ shell'
        assert.ok not out.includes '$ read'
        assert.ok not out.includes '$ webfetch'
        assert.ok not out.includes '$ grep'

    test 'a non-shell tool is never shown even when its name is close' ->

        assert.ok not (run ['cccccc']).includes '$ bash'

    test 'no ellipsis markers anywhere, since there are no runs to continue' ->

        every = run []
        assert.ok not every.includes("\n…")


###
    ███       ███████    ███████   
    ███      ███   ███  ███        
    ███      ███   ███  ███  ████  
    ███      ███   ███  ███   ███  
    ███████   ███████    ███████   
###

use ./fixtures/build
use .. ◆ db log style
use ./utils ▪ throws

#  log is the console builtin as well, so the module is called something else
#  here — otherwise `log {db: …}` prints the argument.

history = log

DB_PATH = build.fixtures().DB_PATH

plain = style.createStyle false

run = (ids, width=80) ->

    database = db.openDb DB_PATH
    history {db: database, prefixes: ids, width, style: plain}

markers = (out) -> out.split('\n').filter (l) -> l.startsWith('>') or l.startsWith '$'

# ███████    ███       ███████    ███████  ███   ███   ███████
# ███   ███  ███      ███   ███  ███       ███  ███   ███
# ███████    ███      ███   ███  ███       ███████    ███████
# ███   ███  ███      ███   ███  ███       ███  ███        ███
# ███████    ███████   ███████    ███████  ███   ███  ███████

▸ log blocks

    ▸ starts with the session row, then the blocks

        lines = run(['aaaaaa']).split('\n')

        lines[0].trimStart().startsWith('aaaaaa ') ▸ yes
        lines[1] ▸ '> user'
        lines[2] ▸ 'hello'

    ▸ shows tool calls and results inline, in order

        markers(run(['aaaaaa'])) ▸ [
            '> user'
            '> agent plan'
            '$ shell'
            '$ shell result'
            '> user'
            '> agent build'
            '$ shell'
            '$ webfetch'
            '$ webfetch result'
            '$ grep'
            '$ read'
            '$ read result'
        ]

    ▸ an assistant message with no agent field continues the run

        lines = run(['aaaaaa']).split('\n')
        lines[lines.indexOf('no agent field') - 1] ▸ '…'

    ▸ agent text after a tool call continues with an ellipsis

        lines = run(['aaaaaa']).split('\n')
        cont = lines.indexOf '…', lines.indexOf '$ shell result'

        cont > lines.indexOf('$ shell result') ▸ yes
        lines[cont + 1] ▸ 'done listing'

#  ███████  ████████  ███      ████████   ███████  █████████  ███   ███████   ███   ███
# ███       ███       ███      ███       ███          ███     ███  ███   ███  ████  ███
# ███████   ███████   ███      ███████   ███          ███     ███  ███   ███  ███ █ ███
#      ███  ███       ███      ███       ███          ███     ███  ███   ███  ███  ████
# ███████   ████████  ███████  ████████   ███████     ███     ███   ███████   ███   ███

▸ log selection

    ▸ shows every session when no ids are given

        every = run []
        every.includes('$ webfetch') ▸ yes
        every.includes('$ shell') ▸ yes

    ▸ ids filter which sessions are shown

        not run(['cccccc']).includes('$ webfetch') ▸ yes

    ▸ ids keep the order they were given in

        out = run ['bbbbbb', 'aaaaaa']
        out.indexOf('bbbbbb') < out.indexOf('aaaaaa') ▸ yes

    ▸ sessions are separated by a blank line

        lines = run(['aaaaaa', 'cccccc']).split('\n')
        secondRow = lines.findIndex (l) -> l.trimStart().startsWith 'cccccc '

        lines[secondRow - 1] ▸ ''

    ▸ a session with no renderable blocks prints only its row

        run(['bbbbbb']) ▸ run(['bbbbbb']).split('\n')[0]

# ████████  ████████   ████████    ███████   ████████    ███████
# ███       ███   ███  ███   ███  ███   ███  ███   ███  ███
# ███████   ███████    ███████    ███   ███  ███████    ███████
# ███       ███   ███  ███   ███  ███   ███  ███   ███       ███
# ████████  ███   ███  ███   ███   ███████   ███   ███  ███████

▸ log errors

    ▸ unknown id surfaces the error

        throws(-> run(['zzzzzz']), /no\x20session/i)

    ▸ output ends without a trailing blank line

        out = run ['aaaaaa']
        not out.endsWith('\n') ▸ yes

#  `occ cat` — the conversation, tools and all.
#
#  Consecutive turns from one message are joined: the block splitter emits a
#  turn per text part, and a tool call in the middle should not split a
#  sentence the agent wrote in one breath.

use ./sessions

mergeTurns = (blocks) ->

    merged = []

    for block in blocks

        previous = merged.at -1

        sameMessage =
            previous != undefined and
            previous.kind == 'turn' and
            block.kind == 'turn' and
            previous.message == block.message

        if sameMessage
            previous.text = "#{previous.text}\n\n#{block.text}"
            continue

        merged.push Object.assign({}, block)

    merged

cat = (opt) ->

    database = opt.db
    prefixes = opt.prefixes ? []
    width = opt.width ? 80
    sty = opt.style

    turns = (blocks) ->

        spoken = blocks.filter (b) -> b.kind == 'turn'
        mergeTurns spoken

    sessions database, prefixes, width, sty, turns

export cat
#  colours: a palette, and the roles a renderer picks from it.

class StyleError extends Error

    @: message ->
        super message
        @name = 'StyleError'

CODES =
    reset: [0, 0]
    bold: [1, 22]
    dim: [2, 22]
    italic: [3, 23]
    underline: [4, 24]
    black: [30, 39]
    red: [31, 39]
    green: [32, 39]
    yellow: [33, 39]
    blue: [34, 39]
    magenta: [35, 39]
    cyan: [36, 39]
    white: [37, 39]
    gray: [90, 39]
    bgBlack: [40, 49]
    bgRed: [41, 49]
    bgGreen: [42, 49]
    bgYellow: [43, 49]
    bgBlue: [44, 49]
    bgMagenta: [45, 49]
    bgCyan: [46, 49]
    bgWhite: [47, 49]
    bgGray: [100, 49]

PLAIN = (text) -> String(text)

TRUE_COLOR =
    foreground: [38, 39]
    background: [48, 49]

rowId       = (c) -> (text) -> c.bg('#111', c.fg('#ff0', text))
rowLast     = (c) -> (text) -> c.bg('#111', c.fg('#55a', text))
rowDuration = (c) -> (text) -> c.bg('#111', c.fg('#88f', text))
rowTurns    = (c) -> (text) -> c.bg('#111', c.red(text))
rowName     = (c) -> (text) -> c.bg('#181818', c.bold(text))

turnUser     = (c) -> (text) -> c.bg('#181818', c.fg('#ff0', c.bold(text)))
turnAgent    = (c) -> (text) -> c.bg('#181818', c.fg('#f22', c.bold(text)))
turnMode     = (c) -> (text) -> c.bg('#101010', c.fg('#88f', text))
turnContinue = (c) -> c.gray

toolCall   = (c) -> (text) -> c.bg('#181818', c.fg('#88f', c.bold(text)))
toolResult = (c) -> (text) -> c.bg('#101010', c.fg('#aaa', c.bold(text)))
toolExit   = (c) -> (text) -> c.bg('#ff1818', c.fg('#ff0', c.bold(text)))
toolNote   = (c) -> c.gray

delWarning  = (c) -> (text) -> c.bg '#f00', c.bold(c.fg('#ff0', text))
delQuestion = (c) -> (text) -> c.bg '#a00', c.bold(c.fg('#ff0', text))

ROLES =
    row:
        id: rowId
        last: rowLast
        duration: rowDuration
        turns: rowTurns
        name: rowName
    turn:
        user: turnUser
        agent: turnAgent
        mode: turnMode
        continue: turnContinue
    tool:
        call: toolCall
        result: toolResult
        exit: toolExit
        note: toolNote
    del:
        warning: delWarning
        question: delQuestion

parseHex = (hex) ->

    if not hex is str
        throw new StyleError "color must be a string, got #{typeof hex}"

    digits = (/^#?([0-9a-f]{3}|[0-9a-f]{6})$/i).exec hex.trim()

    if digits == null
        throw new StyleError "invalid color \"#{hex}\", expected #rgb or #rrggbb with hex digits"

    value = if digits[1].length == 3 then Array.from(digits[1]).map((d) -> d + d).join('') else digits[1]

    [
        Number.parseInt(value.slice(0, 2), 16)
        Number.parseInt(value.slice(2, 4), 16)
        Number.parseInt(value.slice(4, 6), 16)
    ]

makeHexStyle = (enabled, layer) ->

    [open, close] = TRUE_COLOR[layer]

    if not enabled then ⮐ (hex, text) -> PLAIN text

    (hex, text) ->
        [r, g, b] = parseHex hex
        "\u001b[#{open};2;#{r};#{g};#{b}m#{text}\u001b[#{close}m"

code = (open, close) -> (text) -> "\u001b[#{open}m#{text}\u001b[#{close}m"

makePalette = (enabled) ->

    palette = Object.assign {}, PLAIN, {
        fg: makeHexStyle(enabled, 'foreground')
        bg: makeHexStyle(enabled, 'background')
    }

    if not enabled
        for key in Object.keys CODES
            palette[key] = PLAIN
        ⮐ palette

    for entry in Object.entries CODES
        key = entry[0]
        pair = entry[1]
        palette[key] = code(pair[0], pair[1])

    palette

createStyle = (enabled) ->

    on = Boolean enabled
    palette = makePalette on

    style =
        enabled: on
        palette: palette
        fg: palette.fg
        bg: palette.bg

    for entry in Object.entries ROLES
        group = entry[0]
        entries = entry[1]
        picks = Object.entries(entries).map ([name, pick]) -> [name, pick(palette)]
        style[group] = Object.fromEntries picks

    style

export
    createStyle: createStyle
    StyleError: StyleError
#  the entry point: argv in, one command out.
#
#  Nothing here decides anything. The table finds the command, the module
#  owns it, and the two things that need a process — the palette and the exit
#  code — are decided here.

use ./db
use ./style
use ./terminal
use ./ls
use ./cat
use ./log
use ./shell
use ./del
use ./resume

#  log is the console builtin, so the module answers to a second name

history = log

#  An array and a join, not a triple-quoted string: a triple-quoted string has
#  its common indentation stripped from every line, and this text is printed
#  indented by four.

USAGE = [
    ''
    '    occ - list, dump and delete opencode v2 sessions'
    ''
    '    usage:'
    ''
    '      occ ls [sess...]        show session table'
    '      occ cat [sess...]       show session conversation'
    '      occ log [sess...]       show session history including tool calls'
    '      occ shell [sess...]     show shell commands with their output'
    '      occ resume sess         resume a session in opencode'
    '      occ del sess [sess...]  delete sessions, asks for confirmation'
    ''
    '    sess: a fragment of a session id or session title'
    ''
    '    table: id datetime minutes turns title'
    '    '
    ]

HELP = USAGE.join '\n'

COMMANDS =
    ls: run: ls
    cat: run: cat
    log: run: history
    shell: run: shell
    #  resume.kode exports personaOf as well, so `use ./resume` binds the
    #  module and the entry point has to name the function inside it.

    resume: run: resume.resume
    del:
        run: del
        writable: true

main = (argv) ○->

    given = argv[0]
    ids = argv.slice 1

    if given in ['-h' '--help' 'help']
        process.stdout.write "#{HELP}\n"
        ⮐ 0

    command = if argv.length == 0 then 'ls' else given

    entry = COMMANDS[command]

    if empty entry
        process.stderr.write "unknown command \"#{command}\"\n\n#{HELP}\n"
        ⮐ 1

    handler = entry.run
    writable = entry.writable ? false

    p = db.resolveDbPath()
    database = if writable then db.openWritable(p) else db.openDb(p)

    try
        #  `?` and not `||`: there is no ||, and ? is ?? — the same here,
        #  since a column count is a number or nothing.

        width = process.stdout.columns ? 80
        sty = style.createStyle Boolean(process.stdout.isTTY) and not process.env.NO_COLOR

        out = ○handler({db: database, prefixes: ids, width, style: sty, io: terminal()})

        if out is str and not empty out then process.stdout.write "#{out}\n"

        if out is num then ⮐ out
        ⮐ 0
    catch err
        database.close()
        throw err

    database.close()
    0

#  What bin/occ calls. The try belongs to the program and not to a command:
#  a command that refuses has already said why, and saying it twice would put
#  the message on stderr where the refusal did not belong.

run = (argv) ○->

    try
        process.exitCode = ○main argv
    catch e
        if e instanceof db.OclsError
            process.stderr.write "occ: #{e.message}\n"
            process.exitCode = 1
        else
            throw e

export
    main: main
    run: run